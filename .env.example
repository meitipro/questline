# Which GenLayer network the whole app talks to. See lib/chain.ts.
#
# studionet is the default: as of 2026-07-29 the GenLayer team confirmed a
# Bradbury network fault where a deploy reports FINALIZED with written storage
# and gen_getContractCode then says there is no code at the address.
NEXT_PUBLIC_GENLAYER_NETWORK=studionet

# The deployed Questline contract. Leave empty and the site runs the seeded
# demonstration world with a banner saying so; nothing pretends to be on chain.
NEXT_PUBLIC_QUESTLINE_ADDRESS=

# Optional. Studio has no working block explorer, so links are dropped rather
# than pointed at a host that answers 503. Set this if one appears.
NEXT_PUBLIC_GENLAYER_EXPLORER=

# Canonical origin, used in chronicle permalinks and share cards. Vercel fills
# its own production domain in automatically when this is unset.
NEXT_PUBLIC_ORIGIN=

# Deploy and seed only. Never committed, never passed as an argument.
#   PowerShell:  $env:QUESTLINE_DEPLOYER_KEY = "0x..."
QUESTLINE_DEPLOYER_KEY=
