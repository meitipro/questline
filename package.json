{
  "name": "questline",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3400",
    "build": "next build",
    "start": "next start -p 3400",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check.mjs",
    "lint:contract": "node scripts/lint-contract.mjs",
    "test": "node scripts/check.mjs && node --test \"tests/parity/*.test.mjs\" && python contracts/test_helpers.py",
    "deploy": "node scripts/deploy.mjs",
    "seed": "node scripts/seed.mjs",
    "verify": "node scripts/verify.mjs",
    "admin": "node scripts/admin.mjs",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "genlayer-js": "^1.2.0",
    "next": "^14.2.32",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "typescript": "5.5.3"
  },
  "engines": {
    "node": ">=18.18"
  },
  "license": "MIT",
  "description": "A persistent text world where the game master is an Intelligent Contract: public rules, seeded rolls anyone can recompute, and a chronicle nobody can quietly edit."
}
